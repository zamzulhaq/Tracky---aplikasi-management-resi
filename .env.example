# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WooCommerce REST API. Prefix VITE_ wajib agar terlihat di browser (Vite).
# WOO_BASE_URL harus full REST path: https://your-store.com/wp-json/wc/v3
VITE_WOO_BASE_URL="https://your-store.com/wp-json/wc/v3"
# Consumer Key/Secret TIDAK lewat env — diisi lewat menu Profile di dalam
# aplikasi (disimpan di localStorage). Ini mencegah key tertanam di APK.

# Status workflow toko (custom). Bila kosong/tidak diisi, fallback ke:
#   fetch = processing, complete = completed.
# VITE_WOO_FETCH_STATUS = pool scan (yang di-match scanner).
# VITE_WOO_FETCH_STATUSES = daftar status untuk tab Shipments, dipisah koma.
VITE_WOO_FETCH_STATUS="sudah-lunas"
VITE_WOO_FETCH_STATUSES="sudah-lunas,sudah-dikirim,completed"
VITE_WOO_COMPLETE_STATUS="sudah-dikirim"

# Firebase Firestore (fase integrasi). Isi dari firebaseConfig project.
FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
